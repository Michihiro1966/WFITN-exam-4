# Copy to .env for local development and fill in the values.

# PostgreSQL connection string (required).
DATABASE_URL=postgres://user:password@localhost:5432/wfitn

# Set to "require" only when connecting to Postgres over a public/proxy URL that
# needs TLS (e.g. a Railway public database URL). Leave empty for local Postgres
# or Railway's private ${{Postgres.DATABASE_URL}} connection.
PGSSLMODE=

# Strong password for the admin dashboard (required).
ADMIN_PASSWORD=change-me

# Public base URL of the deployed app (used for QR code and email links).
# Leave empty locally; set to the Railway domain in production.
APP_BASE_URL=

# Course branding.
COURSE_NAME=WFITN Neurovascular Anatomy Course Zurich 2026
AVATAR_URL=https://avatars.githubusercontent.com/u/269770510?v=4

# Exam length in minutes.
EXAM_DURATION_MINUTES=40

# Missed-question feedback emails (optional). Two transports are supported:
#
# 1) SendGrid (recommended, especially on Railway which BLOCKS outbound SMTP).
#    Sends over HTTPS. Create a free SendGrid account, verify a Single Sender
#    (your from address), create an API key, then set:
SENDGRID_API_KEY=
# From address; must be the verified Single Sender (or a verified domain).
# Falls back to SMTP_FROM when empty.
SENDGRID_FROM=WFITN Anatomy Course <no-reply@example.com>
#
# 2) SMTP (works locally / on hosts that allow outbound SMTP; blocked on Railway).
#    Disabled until SMTP_HOST, SMTP_USER and SMTP_PASS are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=WFITN Anatomy Course <no-reply@example.com>
