# Copy to .env for local development and fill in the values.

# PostgreSQL connection string (required).
DATABASE_URL=postgres://user:password@localhost:5432/wfitn

# Set to "require" only when connecting to Postgres over a public/proxy URL that
# needs TLS (e.g. a Railway public database URL). Leave empty for local Postgres
# or Railway's private ${{Postgres.DATABASE_URL}} connection.
PGSSLMODE=

# Strong password for the admin dashboard (required).
ADMIN_PASSWORD=change-me

# Public base URL of the deployed app (used for QR code and email links).
# Leave empty locally; set to the Railway domain in production.
APP_BASE_URL=

# Course branding.
COURSE_NAME=WFITN Neurovascular Anatomy Course Zurich 2026
AVATAR_URL=https://avatars.githubusercontent.com/u/269770510?v=4

# Exam length in minutes.
EXAM_DURATION_MINUTES=40

# SMTP settings for the missed-question feedback emails (optional).
# Feedback emails are disabled until SMTP_HOST, SMTP_USER and SMTP_PASS are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=WFITN Anatomy Course <no-reply@example.com>
